# Keep the pushed history linear. A merge commit is rejected here.
#
# Git sends one line per ref on stdin. Each line holds the local ref, the
# local SHA, the remote ref, and the remote SHA.
#
# An all-zero SHA has a meaning that depends on its side. An all-zero local
# SHA means the push deletes the ref, so there is nothing to inspect. An
# all-zero remote SHA means the ref is new on the remote, so the commits to
# inspect are the ones no other remote ref holds yet. That exclusion keeps
# the merge commits already on `main` from failing a new branch.
#
# To merge a branch without a merge commit, rebase it first, then fast
# forward:
#
#   git rebase main my-branch
#   git switch main && git merge --ff-only my-branch

ZERO="0000000000000000000000000000000000000000"
failed=0
pushing=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  pushing=1

  if [ "$remote_sha" = "$ZERO" ]; then
    merges=$(git rev-list --merges "$local_sha" --not --remotes=origin)
  else
    merges=$(git rev-list --merges "$remote_sha..$local_sha")
  fi

  [ -z "$merges" ] && continue

  failed=1
  echo "pre-push: $local_ref carries a merge commit, so the push was stopped."
  echo "$merges" | while read -r sha; do
    echo "  $(git log -1 --format='%h %s' "$sha")"
  done
done

if [ "$failed" -ne 0 ]; then
  echo ""
  echo "Rebase the branch, then fast forward, so the history stays linear."
  exit 1
fi

# A push that only deletes a ref changes no code, so the checks are skipped.
[ "$pushing" -eq 0 ] && exit 0

# These two take about 13 seconds together. They belong here rather than in
# `pre-commit`, which stays fast enough to run on every commit. CI runs them
# again, but a CI round trip costs about 2.5 minutes.
#
# `tsc --noEmit` covers the tests as well as `src`. The build inside `test`
# covers `src` alone, so neither one makes the other redundant.
echo "pre-push: checking types..."
pnpm exec tsc --noEmit || exit 1

echo "pre-push: running tests..."
pnpm test || exit 1
