{
  "type": "record",
  "name": "OrderPlaced",
  "namespace": "com.example.orders",
  "doc": "An order left the checkout.",
  "fields": [
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "lines",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "OrderLine",
          "namespace": "com.example.orders",
          "doc": "One line of an order.",
          "fields": [
            {
              "name": "sku",
              "type": "string"
            },
            {
              "name": "quantity",
              "type": "int"
            }
          ]
        }
      },
      "doc": "What was ordered."
    },
    {
      "name": "shipping",
      "type": {
        "type": "record",
        "name": "Address",
        "namespace": "com.example.orders",
        "doc": "Where an order goes.",
        "fields": [
          {
            "name": "line1",
            "type": "string"
          },
          {
            "name": "city",
            "type": "string"
          },
          {
            "name": "postcode",
            "type": "string"
          }
        ]
      },
      "doc": "Where the order goes."
    },
    {
      "name": "billing",
      "type": [
        "null",
        "com.example.orders.Address"
      ],
      "doc": "Where the invoice goes, when it is not the shipping address.",
      "default": null
    },
    {
      "name": "metadata",
      "type": {
        "type": "map",
        "values": "string"
      },
      "doc": "Whatever the checkout wanted to carry along."
    },
    {
      "name": "tracking",
      "type": [
        "string",
        "null"
      ],
      "doc": "What the carrier calls this shipment.",
      "default": "pending"
    },
    {
      "name": "attempts",
      "type": [
        "int",
        "null"
      ],
      "doc": "How many times delivery was tried.",
      "default": 0
    }
  ]
}
