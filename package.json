{
  "name": "tsp-asyncapi-workspace",
  "version": "0.0.0",
  "description": "Workspace root. Publishes nothing; holds the shared toolchain and the test suite.",
  "keywords": [
    "typespec",
    "asyncapi",
    "emitter",
    "asyncapi-3",
    "kafka",
    "event-driven"
  ],
  "homepage": "https://marvin-hsu.github.io/tsp-asyncapi/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marvin-hsu/tsp-asyncapi.git"
  },
  "bugs": {
    "url": "https://github.com/marvin-hsu/tsp-asyncapi/issues"
  },
  "type": "module",
  "scripts": {
    "clean": "pnpm -r clean",
    "build": "tsc -b tsconfig.ws.json",
    "watch": "tsc -b tsconfig.ws.json --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "api-extractor:local": "pnpm -r api-extractor:local",
    "api-extractor:ci": "pnpm -r api-extractor:ci",
    "check:package": "pnpm build && pnpm -r check:package",
    "mutation": "stryker run",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm build && pnpm api-extractor:ci && pnpm test:cov && pnpm check:package && pnpm audit --prod",
    "prepare": "husky",
    "typecheck": "tsc -b tsconfig.ws.json && tsc -p tsconfig.json"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  },
  "author": "Marvin Hsu <contact@marvinhsu.dev> (https://github.com/marvin-hsu)",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.3",
    "@asyncapi/protobuf-schema-parser": "^3.9.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.2.0",
    "@types/yaml": "^1.9.7",
    "@typespec/compiler": "^1.15.0",
    "@typespec/protobuf": "0.85.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsp-asyncapi": "workspace:*",
    "tsp-asyncapi-core": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true,
  "imports": {
    "#core/*": "./packages/tsp-asyncapi-core/src/*",
    "#emitter/*": "./packages/tsp-asyncapi/src/*"
  }
}
