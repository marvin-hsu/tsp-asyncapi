{
  "name": "tsp-asyncapi",
  "version": "0.5.0",
  "type": "module",
  "description": "AsyncAPI emitter for TypeSpec",
  "main": "dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "tspMain": "lib/main.tsp",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "default": "./dist/src/testing.js"
    }
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "README.zh-TW.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": "Marvin Hsu <contact@marvinhsu.dev> (https://github.com/marvin-hsu)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marvin-hsu/tsp-asyncapi.git"
  },
  "bugs": {
    "url": "https://github.com/marvin-hsu/tsp-asyncapi/issues"
  },
  "homepage": "https://marvin-hsu.github.io/tsp-asyncapi/",
  "keywords": [
    "typespec",
    "asyncapi",
    "emitter",
    "asyncapi-3",
    "kafka",
    "event-driven"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "tsp-asyncapi-core": "workspace:~",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@typespec/compiler": "^1.15.0",
    "@typespec/protobuf": "0.85.x",
    "tsp-avro": "0.1.x"
  },
  "scripts": {
    "clean": "rimraf ./dist ./temp",
    "build": "tsc -p tsconfig.build.json",
    "api-extractor:local": "api-extractor run --local",
    "api-extractor:ci": "api-extractor run",
    "check:package": "pnpm pack --pack-destination temp && publint && attw --profile esm-only temp/tsp-asyncapi-[0-9]*.tgz"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.58.12",
    "@typespec/compiler": "^1.15.0",
    "@typespec/protobuf": "0.85.0",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "tsp-avro": "workspace:~",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@typespec/protobuf": {
      "optional": true
    },
    "tsp-avro": {
      "optional": true
    }
  }
}
