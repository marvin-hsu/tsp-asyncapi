# Copy this file to `.env` and fill in the values. `.env` is ignored by git.
#
#   cp .env.example .env && chmod 600 .env
#
# Nothing in `src` or `test` reads these. They serve local command line work
# only. CI takes its own values from the repository secrets instead.
#
# To load them into a shell:
#
#   set -a && . ./.env && set +a

# Token for the SonarCloud API, used to query analyses and issues from a
# terminal. Create one under My Account -> Security on sonarcloud.io.
SONAR_TOKEN=
